rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This app uses anonymous Firebase Authentication. Enable it in Firebase Console.
    // Quiz documents are immutable after publish; scoreboard entries are independent docs.
    match /artifacts/{appId}/public/data/quizzes/{quizId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'id', 'creatorName', 'pronoun', 'avatar', 'customAvatarUrl',
          'themeId', 'passScore', 'createdAt', 'questions'
        ])
        // Keep the public document schema allow-listed so creator-only or unexpected
        // fields cannot accidentally become readable by every authenticated player.
        && request.resource.data.keys().hasOnly([
          'id', 'creatorName', 'pronoun', 'avatar', 'customAvatarUrl',
          'themeId', 'passScore', 'createdAt', 'questions'
        ])
        && request.resource.data.id == quizId
        && request.resource.data.id is string
        && request.resource.data.id.size() == 6
        && request.resource.data.creatorName is string
        && request.resource.data.creatorName.size() >= 2
        && request.resource.data.creatorName.size() <= 60
        && request.resource.data.pronoun in ['m', 'f', 't']
        && request.resource.data.avatar is string
        && request.resource.data.customAvatarUrl is string
        && request.resource.data.themeId is string
        && request.resource.data.createdAt is int
        && request.resource.data.questions is string
        && request.resource.data.questions.size() > 0
        && request.resource.data.questions.size() < 900000
        && request.resource.data.passScore is number
        && request.resource.data.passScore >= 1
        && request.resource.data.passScore <= 50;
      allow update, delete: if false;

      match /attempts/{attemptId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll([
            'id', 'friendName', 'avatarId', 'relationshipId', 'score', 'total',
            'avgTimeSec', 'maxStreak', 'xpEarned', 'missedDealbreaker', 'answers', 'timestamp'
          ])
          && request.resource.data.keys().hasOnly([
            'id', 'friendName', 'avatarId', 'relationshipId', 'score', 'total',
            'avgTimeSec', 'maxStreak', 'xpEarned', 'missedDealbreaker', 'answers', 'timestamp'
          ])
          && request.resource.data.id == attemptId
          && request.resource.data.friendName is string
          && request.resource.data.friendName.size() >= 2
          && request.resource.data.friendName.size() <= 60
          && request.resource.data.score is number
          && request.resource.data.total is number
          && request.resource.data.total >= 1
          && request.resource.data.total <= 50
          && request.resource.data.score >= 0
          && request.resource.data.score <= request.resource.data.total
          && request.resource.data.avgTimeSec is number
          && request.resource.data.avgTimeSec >= 0
          && request.resource.data.avgTimeSec <= 3600
          && request.resource.data.maxStreak is number
          && request.resource.data.maxStreak >= 0
          && request.resource.data.maxStreak <= request.resource.data.total
          && request.resource.data.xpEarned is number
          && request.resource.data.xpEarned >= 0
          && request.resource.data.xpEarned <= 100000
          && request.resource.data.missedDealbreaker is bool
          && request.resource.data.answers is map
          && request.resource.data.answers.size() <= request.resource.data.total
          && request.resource.data.timestamp is int;
        // Permit an exact retry of the same stable attempt ID, but never edits.
        allow update: if request.auth != null && request.resource.data == resource.data;
        allow delete: if false;
      }
    }
  }
}